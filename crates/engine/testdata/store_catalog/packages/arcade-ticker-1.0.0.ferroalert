{"schema":1,"id":"store.arcade-ticker","name":"Arcade Ticker Alert","events":["follow"],"variations":[{"id":"arcade-default","name":"Arcade Default","condition":null,"priority":0,"weight":1,"title":"{name} joined the squad!","body":"{message}","sound":null,"volume":70,"duration_ms":5000,"tts":false,"layout":"stack","css":".card { border: 2px solid #33d4ff; border-radius: 12px; padding: 14px; background: #101216; color: #eef0f4; }","anim":{"in":"fade","out":"fade","text":"none","in_ms":300,"out_ms":300,"text_delay_ms":100},"custom_enabled":true,"html":"<div class=\"card\"><strong>{name}</strong> <span>{accent_label}</span><p>{message}</p></div>","fields":[{"key":"accent_label","label":"Badge label","type":"text","default":"PLAYER 1"}],"field_values":{"accent_label":"NEW CHALLENGER"}}]}