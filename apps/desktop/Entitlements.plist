<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ask Spotify or Music for the playing song (only when Settings, Music says so). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- The Studio loads OBS's engine and plugins, signed by OBS, not by us: the hardened
       runtime refuses libraries from another Team ID without this (25 Oct, LESSONS R-77). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The Studio's camera and microphone sources (macOS still asks the streamer first). -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
