# Environment for ferrocast-relay (copy to /etc/ferrocast/relay.env, chmod 600).
RELAY_BIND=127.0.0.1:8787
RELAY_DATA=/var/lib/ferrocast/relay.db
# The public address Kick redirects to and sends webhooks to (behind the reverse proxy).
RELAY_PUBLIC_URL=https://ferrocast-relay.clearcraftlabs.com
# From dev.kick.com → your app. Set the app's redirect URL to
#   $RELAY_PUBLIC_URL/v1/kick/callback
# and its webhook URL to
#   $RELAY_PUBLIC_URL/v1/kick/webhook
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
RUST_LOG=info
