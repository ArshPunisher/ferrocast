# systemd unit for the relay on the Oracle ARM server.
[Unit]
Description=Ferrocast relay
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/ferrocast/relay.env
ExecStart=/usr/local/bin/ferrocast-relay
User=ferrocast
Group=ferrocast
Restart=always
RestartSec=3
StateDirectory=ferrocast
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ferrocast

[Install]
WantedBy=multi-user.target
